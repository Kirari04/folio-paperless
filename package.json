{
  "name": "folio-paperless",
  "description": "A polished, mobile-first Paperless-ngx client built with Expo and React Native.",
  "main": "index.ts",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kirari04/folio-paperless.git"
  },
  "bugs": {
    "url": "https://github.com/Kirari04/folio-paperless/issues"
  },
  "homepage": "https://github.com/Kirari04/folio-paperless#readme",
  "dependencies": {
    "@expo/ui": "~57.0.8",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.9",
    "expo-auth-session": "~57.0.5",
    "expo-background-task": "~57.0.7",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-document-scanner": "^0.2.8",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.8",
    "expo-print": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.7",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "~57.0.7",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-blob-util": "^0.24.10",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-pdf": "7.0.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "eas-build-post-install": "node scripts/eas-build-post-install.mjs",
    "assert:autolinking": "node scripts/assert-autolinking-flavors.mjs",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "test:altstore-source": "node --test tests/altstore-source.test.mjs",
    "assert:distribution-config": "node scripts/assert-distribution-config.mjs",
    "assert:store-metadata": "node scripts/assert-store-metadata.mjs"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-sharing"
        ]
      },
      "ios": {
        "buildFromSource": [
          "expo-sharing"
        ]
      }
    }
  }
}
