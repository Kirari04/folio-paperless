+#pragma mark native PDF search
+
+- (BOOL)isValidSearchQuery:(NSString *)query
+{
+    if (query.length > MAX_SEARCH_QUERY_LENGTH) return NO;
+    NSCharacterSet *controls = [NSCharacterSet controlCharacterSet];
+    return [query rangeOfCharacterFromSet:controls].location == NSNotFound;
+}
+
+- (void)updatePdfSearch
+{
+    NSString *query = [_searchQuery ?: @"" stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+    if (![self isValidSearchQuery:query]) {
+        [_pdfDocument cancelFindString];
+        _runningSearchQuery = nil;
+        _searchQuery = @"";
+        [_searchMatches removeAllObjects];
+        [_searchPageTextCache removeAllObjects];
+        _highlightedSearchIndex = -1;
+        _pdfView.highlightedSelections = @[];
+        [self emitPdfSearchStatus:@"unavailable" query:@"" matches:@[] truncated:NO];
+        return;
+    }
+    _searchQuery = query;
+    _searchCurrentIndex = 0;
+    [_searchMatches removeAllObjects];
+    [_searchPageTextCache removeAllObjects];
+    _highlightedSearchIndex = -1;
+    _pdfView.highlightedSelections = @[];
+
+    if (query.length == 0) {
+        [_pdfDocument cancelFindString];
+        _runningSearchQuery = nil;
+        [self emitPdfSearchStatus:@"idle" query:@"" matches:@[] truncated:NO];
+        return;
+    }
+    if (!_pdfDocument) return;
+    if (_pdfDocument.isFinding) {
+        [_pdfDocument cancelFindString];
+        return;
+    }
+    [self beginPdfSearch];
+}
+
+- (void)beginPdfSearch
+{
+    if (!_pdfDocument || _searchQuery.length == 0 || _pdfDocument.isFinding) return;
+    _runningSearchQuery = [_searchQuery copy];
+    _searchTruncated = NO;
+    [_searchMatches removeAllObjects];
+    [_searchPageTextCache removeAllObjects];
+    _highlightedSearchIndex = -1;
+    [self emitPdfSearchStatus:@"searching" query:_runningSearchQuery matches:@[] truncated:NO];
+    [_pdfDocument beginFindString:_runningSearchQuery withOptions:NSCaseInsensitiveSearch];
+}
+
+- (void)didMatchString:(PDFSelection *)instance
+{
+    void (^recordMatch)(void) = ^{
+        PDFPage *page = instance.pages.firstObject;
+        if (![self->_runningSearchQuery isEqualToString:self->_searchQuery]
+            || !page
+            || [self->_pdfDocument indexForPage:page] == NSNotFound) return;
+        if (self->_searchMatches.count >= MAX_SEARCH_MATCHES) {
+            self->_searchTruncated = YES;
+            [self->_pdfDocument cancelFindString];
+            return;
+        }
+        PDFSelection *selection = [instance copy];
+        selection.color = [UIColor colorWithRed:1.0 green:0.86 blue:0.18 alpha:0.42];
+        [self->_searchMatches addObject:selection];
+        if (self->_searchMatches.count >= MAX_SEARCH_MATCHES) {
+            self->_searchTruncated = YES;
+            [self->_pdfDocument cancelFindString];
+        }
+    };
+    if ([NSThread isMainThread]) recordMatch();
+    else dispatch_async(dispatch_get_main_queue(), recordMatch);
+}
+
+- (void)documentDidEndDocumentFind:(NSNotification *)notification
+{
+    void (^finishSearch)(void) = ^{
+        if (notification.object != self->_pdfDocument) return;
+        NSString *finishedQuery = self->_runningSearchQuery;
+        self->_runningSearchQuery = nil;
+        if (![finishedQuery isEqualToString:self->_searchQuery]) {
+            [self beginPdfSearch];
+            return;
+        }
+        NSArray<PDFSelection *> *matches = [self->_searchMatches copy];
+        [self applyPdfSearchHighlightsAndNavigate:YES];
+        NSString *status = matches.count > 0 || [self pdfDocumentContainsSearchableText]
+            ? @"ready"
+            : @"unavailable";
+        [self emitPdfSearchStatus:status query:finishedQuery ?: @"" matches:matches truncated:self->_searchTruncated];
+    };
+    if ([NSThread isMainThread]) finishSearch();
+    else dispatch_async(dispatch_get_main_queue(), finishSearch);
+}
+
+- (BOOL)pdfDocumentContainsSearchableText
+{
+    if (!_pdfDocument) return NO;
+    for (NSUInteger pageIndex = 0; pageIndex < _pdfDocument.pageCount; pageIndex++) {
+        PDFPage *page = [_pdfDocument pageAtIndex:pageIndex];
+        if (page.string.length > 0) return YES;
+    }
+    return NO;
+}
+
+- (void)applyPdfSearchHighlightsAndNavigate:(BOOL)navigate
+{
+    if (!_pdfView || _searchMatches.count == 0) {
+        _pdfView.highlightedSelections = @[];
+        _highlightedSearchIndex = -1;
+        return;
+    }
+    NSUInteger activeIndex = MIN((NSUInteger)MAX(0, _searchCurrentIndex), _searchMatches.count - 1);
+    if (_highlightedSearchIndex >= 0 && (NSUInteger)_highlightedSearchIndex < _searchMatches.count) {
+        _searchMatches[(NSUInteger)_highlightedSearchIndex].color =
+            [UIColor colorWithRed:1.0 green:0.86 blue:0.18 alpha:0.42];
+    }
+    _searchMatches[activeIndex].color = [UIColor colorWithRed:1.0 green:0.58 blue:0.0 alpha:0.68];
+    _highlightedSearchIndex = (NSInteger)activeIndex;
+    _pdfView.highlightedSelections = [_searchMatches copy];
+    if (navigate) [_pdfView goToSelection:_searchMatches[activeIndex]];
+}
+
+- (NSDictionary *)pdfSearchMatchDictionary:(PDFSelection *)selection
+{
+    PDFPage *page = selection.pages.firstObject;
+    if (!page || !_pdfDocument) return nil;
+    NSUInteger pageIndex = [_pdfDocument indexForPage:page];
+    if (pageIndex == NSNotFound) return nil;
+    NSRange range = [selection rangeAtIndex:0 onPage:page];
+    NSNumber *pageKey = @(pageIndex);
+    NSString *pageText = _searchPageTextCache[pageKey];
+    if (!pageText) {
+        pageText = page.string ?: @"";
+        _searchPageTextCache[pageKey] = pageText;
+    }
+    if (range.location == NSNotFound || NSMaxRange(range) > pageText.length) return nil;
+    NSUInteger from = range.location > SEARCH_SNIPPET_RADIUS ? range.location - SEARCH_SNIPPET_RADIUS : 0;
+    NSUInteger to = MIN(pageText.length, NSMaxRange(range) + SEARCH_SNIPPET_RADIUS);
+    NSString *before = [pageText substringWithRange:NSMakeRange(from, range.location - from)];
+    NSString *hit = [pageText substringWithRange:range];
+    NSString *after = [pageText substringWithRange:NSMakeRange(NSMaxRange(range), to - NSMaxRange(range))];
+    if (from > 0) before = [@"…" stringByAppendingString:before];
+    if (to < pageText.length) after = [after stringByAppendingString:@"…"];
+    return @{
+        @"page": @(pageIndex + 1),
+        @"start": @(range.location),
+        @"end": @(NSMaxRange(range)),
+        @"snippetBefore": before,
+        @"snippetMatch": hit,
+        @"snippetAfter": after,
+    };
+}
+
+- (void)emitPdfSearchStatus:(NSString *)status
+                      query:(NSString *)query
+                    matches:(NSArray<PDFSelection *> *)matches
+                  truncated:(BOOL)truncated
+{
+    NSMutableArray<NSDictionary *> *serializedMatches = [NSMutableArray new];
+    for (PDFSelection *selection in matches) {
+        NSDictionary *serialized = [self pdfSearchMatchDictionary:selection];
+        if (serialized) [serializedMatches addObject:serialized];
+    }
+    NSDictionary *payload = @{
+        @"status": status,
+        @"query": query ?: @"",
+        @"matches": serializedMatches,
+        @"truncated": @(truncated),
+    };
+    NSError *error = nil;
+    NSData *json = [NSJSONSerialization dataWithJSONObject:payload options:0 error:&error];
+    if (!json || error) return;
+    NSString *message = [[NSString alloc] initWithData:json encoding:NSUTF8StringEncoding];
+    [self notifyOnChangeWithMessage:[@"searchResult|" stringByAppendingString:message]];
+}
