+        int to = Math.min(characterCount, start + length + SEARCH_SNIPPET_RADIUS);
+        String excerpt = textPage.textPageGetText(from, Math.max(0, to - from));
+        if (excerpt == null) excerpt = "";
+        int relativeStart = Math.min(excerpt.length(), Math.max(0, start - from));
+        int relativeEnd = Math.min(excerpt.length(), relativeStart + length);
+        String before = (from > 0 ? "…" : "") + excerpt.substring(0, relativeStart);
+        String hit = excerpt.substring(relativeStart, relativeEnd);
+        String after = excerpt.substring(relativeEnd) + (to < characterCount ? "…" : "");
