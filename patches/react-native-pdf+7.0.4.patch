+            float left = clamp01(Math.min(deviceRect.left, deviceRect.right) / (float) width);
+            float right = clamp01(Math.max(deviceRect.left, deviceRect.right) / (float) width);
+            float top = clamp01(Math.min(deviceRect.top, deviceRect.bottom) / (float) height);
+            float bottom = clamp01(Math.max(deviceRect.top, deviceRect.bottom) / (float) height);
+            if (right > left && bottom > top) normalizedRects.add(new RectF(left, top, right, bottom));
