{
  "expo": {
    "name": "Folio for Paperless",
    "slug": "folio-paperless",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "folio-paperless",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./assets/locales/en.json",
      "de": "./assets/locales/de.json"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "app.folio.paperless",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Allow Folio to connect directly to a Paperless server on your local network.",
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "0A2A.1",
              "3B52.1",
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "85F4.1",
              "E174.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      },
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionCompleteUntilFirstUserAuthentication"
      }
    },
    "android": {
      "allowBackup": false,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#17231B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "app.folio.paperless",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Folio to scan paper documents.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111713",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128,
          "dark": {
            "backgroundColor": "#111713",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "de"
            ],
            "android": [
              "en",
              "de"
            ]
          }
        }
      ],
      "expo-system-ui",
      "expo-secure-store",
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Folio to protect your document previews with Face ID."
        }
      ],
      [
        "./plugins/withLocalNotifications",
        {
          "color": "#17231B"
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.app.folio.paperless.share",
            "extensionBundleIdentifier": "app.folio.paperless.share-extension",
            "activationRule": {
              "supportsFileWithMaxCount": 20,
              "supportsImageWithMaxCount": 20
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "image/jpeg",
              "image/png",
              "image/tiff",
              "image/heic",
              "image/heif",
              "text/plain"
            ],
            "multipleShareMimeTypes": [
              "application/pdf",
              "image/jpeg",
              "image/png",
              "image/tiff",
              "image/heic",
              "image/heif",
              "text/plain"
            ]
          }
        }
      ],
      "./plugins/withAndroidReleaseSigning"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
